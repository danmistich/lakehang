rules_version = '2';

// Open, no-login invite site — anyone with the link can read and add data.
// These rules just do basic shape/size validation so a stray script or typo
// can't corrupt the data; they do NOT authenticate who's writing.
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per person, doc ID = their name lowercased/trimmed, so
    // resubmitting the same name updates their existing answer instead
    // of creating a duplicate.
    match /rsvps/{name} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.blocks is map
                    && request.resource.data.guests is int
                    && request.resource.data.guests >= 0
                    && request.resource.data.guests <= 20
                    && request.resource.data.keys().hasOnly(['name', 'blocks', 'guests', 'updatedAt']);
      allow delete: if false;
    }

    // One doc per potluck entry — additive only, never overwritten.
    match /potluck/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.item is string
                    && request.resource.data.item.size() > 0
                    && request.resource.data.item.size() <= 80
                    && request.resource.data.keys().hasOnly(['name', 'item', 'createdAt']);
      allow update, delete: if false;
    }

    // Contact info (phone/email) for the mass text/email blast.
    // Write-only by design: guests can submit, but nobody — including the
    // site itself — can read this back through the client SDK. Hosts pull
    // the list from the Firebase Console, which bypasses these rules.
    match /contacts/{entryId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20
                    && (request.resource.data.email.size() > 0 || request.resource.data.phone.size() > 0)
                    && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'createdAt']);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
